# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tempo

# JWT
JWT_SECRET=your-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here

# Server
API_PORT=3001
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# AI
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_FONTS_API_KEY=your-google-web-fonts-api-key
# Replicate — SAM 2 video subject mattes (server-side only; never expose to Next.js)
REPLICATE_API_TOKEN=your-replicate-api-token
# Only needed for remote-only media or files over Replicate's direct-upload limit
# API_PUBLIC_URL=https://api.your-domain.com
# Optional server-to-server origin for the local render/critique browser. In a
# single-machine setup this defaults to http://127.0.0.1:API_PORT.
# API_INTERNAL_URL=http://tempo-api:3001
# Optional: override vision classifier model
# GEMINI_METADATA_MODEL=gemini-3.1-flash-lite
# Optional text-only asset matching refinement. This is deliberately kept on
# a fast model and falls back to deterministic local shot ranking.
# GEMINI_MATCHING_MODEL=gemini-3.1-flash-lite
# Reference intelligence, temporal vision, and forensic reference-vs-edit
# comparison. Asset matching has its own bounded fast-model setting above.
# GEMINI_REFERENCE_MODEL=gemini-3.1-pro-preview
# Complete-video temporal analysis only. Kept separate so testing a new video
# model does not change asset matching or other reference intelligence.
# GEMINI_VIDEO_ANALYSIS_MODEL=gemini-3.7-flash

# Optional: authorized platform session for private/login-gated references.
# Export cookies in Netscape format and keep this server-side path out of git.
# YTDLP_COOKIES_FILE=/absolute/path/to/yt-dlp-cookies.txt
# YTDLP_PATH=/absolute/path/to/yt-dlp
# YTDLP_USER_AGENT=Mozilla/5.0 ...

# Optional: browser binary for WebGPU frame export/visual critique.
# Linux prefers an installed stable Chrome automatically when this is omitted.
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# OFFLINE_WEBGPU_MODE=hardware
# CHROME_CDP_URL=http://127.0.0.1:9222

# Optional local computer-vision accelerator for Edit Like This. `auto` tries
# the isolated Python worker and falls back to Tempo's built-in FFmpeg/TS pass.
# Use `opencv` in production when missing CV dependencies should be fatal.
# REFERENCE_CV_MODE=auto
# PaddleOCR is optional and may download model weights on first use.
# REFERENCE_CV_OCR=false
# Point the API at the isolated Python environment used for the worker.
# REFERENCE_CV_PYTHON=/absolute/path/to/tempo-cv/.venv/bin/python
# REFERENCE_CV_DEVICE=auto

# OpenAI — timed ASR / lyrics captions (Whisper)
OPENAI_API_KEY=your-openai-api-key
# whisper-1 recommended (segment timestamps). Alternatives: gpt-4o-mini-transcribe, gpt-4o-transcribe
# OPENAI_ASR_MODEL=whisper-1

# Redis (for BullMQ render queue)
REDIS_URL=redis://localhost:6379

# Storage (local or s3)
STORAGE_PROVIDER=local

# S3 / R2 (required when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
