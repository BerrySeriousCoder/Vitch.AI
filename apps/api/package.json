{
  "name": "@tempo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --external drizzle-orm --external postgres --external @tempo/db --external @tempo/types --external @tempo/validators --external @tempo/editor-core --no-dts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@google/genai": "^2.16.0",
    "@tempo/db": "workspace:*",
    "@tempo/editor-core": "workspace:*",
    "@tempo/types": "workspace:*",
    "@tempo/validators": "workspace:*",
    "bcryptjs": "^3.0.0",
    "bullmq": "^6.0.9",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "fflate": "^0.8.3",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.2.0",
    "openai": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "1.49.1",
    "replicate": "^1.4.0",
    "socket.io": "^4.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tempo/config-typescript": "workspace:*",
    "@types/bcryptjs": "^2.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^16.6.1",
    "supertest": "^7.2.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
